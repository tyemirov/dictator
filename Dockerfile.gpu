FROM python:3.11.8-slim-bookworm AS builder

ARG TORCH_VERSION=2.8.0
ARG TORCHAUDIO_VERSION=2.8.0
ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cu128

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH \
    HOME=/home/app \
    DICTATOR_MODEL_ROOT=/opt/models \
    HF_HOME=/home/app/.cache/huggingface \
    HUGGINGFACE_HUB_CACHE=/home/app/.cache/huggingface/hub \
    WHISPER_CACHE_DIR=/home/app/.cache/whisper \
    TORCH_HOME=/home/app/.cache/torch

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    espeak-ng \
    ffmpeg \
    git \
    libgomp1 \
    libsndfile1 \
    pkg-config \
    sox \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --shell /bin/bash app

WORKDIR /app

COPY requirements.txt /app/
COPY requirements-gpu.txt /app/
COPY scripts/prefetch_synthesis_models.py /app/scripts/prefetch_synthesis_models.py

RUN python -m venv ${VIRTUAL_ENV} && \
    python -m pip install --upgrade pip setuptools wheel && \
    python -m pip install --no-cache-dir \
        --index-url ${TORCH_INDEX_URL} \
        --extra-index-url https://pypi.org/simple \
        torch==${TORCH_VERSION} \
        torchaudio==${TORCHAUDIO_VERSION} && \
    python -m pip install --no-cache-dir -r /app/requirements-gpu.txt && \
    python /app/scripts/prefetch_synthesis_models.py --output-root ${DICTATOR_MODEL_ROOT}

FROM python:3.11.8-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH \
    HOME=/home/app \
    DICTATOR_MODEL_ROOT=/opt/models \
    DICTATOR_QWEN3_TTS_MODEL_ID=/opt/models/qwen3 \
    HF_HOME=/home/app/.cache/huggingface \
    HUGGINGFACE_HUB_CACHE=/home/app/.cache/huggingface/hub \
    WHISPER_CACHE_DIR=/home/app/.cache/whisper \
    TORCH_HOME=/home/app/.cache/torch

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    espeak-ng \
    ffmpeg \
    libgomp1 \
    libsndfile1 \
    sox \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --shell /bin/bash app

WORKDIR /app

COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /opt/models /opt/models
COPY . /app

RUN mkdir -p \
    /app/.dictator-artifacts \
    /home/app/.cache/huggingface \
    /home/app/.cache/whisper \
    /home/app/.cache/torch && \
    chown -R app:app /app /home/app

USER app

EXPOSE 50051

VOLUME ["/app/.dictator-artifacts", "/home/app/.cache/huggingface", "/home/app/.cache/whisper", "/home/app/.cache/torch"]

CMD ["python", "serve.py", "--config", "/app/config.yml"]
